{
  "version": 8,
  "name": "Periplo Dark",
  "metadata": {
    "periplo:version": "1.1.0-dark",
    "periplo:description": "Dark variant of the Periplo basemap. Mirrors the light style's layer structure / minzooms / filters; only paint values change. Background #1A1614, water #1F2937, parks #202824, neutral dark roads. Designed to recede behind day-color route polylines and pin halos."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "light": { "anchor": "viewport", "color": "white", "intensity": 0.15 },
  "transition": { "duration": 250, "delay": 0 },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#1A1614" }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["park", "cemetery", "recreation_ground", "playground", "pitch", "golf_course"]]],
      "paint": {
        "fill-color": "#202824",
        "fill-antialias": true
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#202824",
        "fill-antialias": true
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["wood", "forest"]]],
      "paint": {
        "fill-color": "#1F2620",
        "fill-antialias": true,
        "fill-opacity": [
          "interpolate", ["linear"], ["zoom"],
          5, 0.5,
          12, 0.9
        ]
      }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["sand", "beach"]]],
      "paint": {
        "fill-color": "#2A2722",
        "fill-antialias": true
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "intermittent"], 1],
      "paint": {
        "fill-color": "#1F2937",
        "fill-antialias": false
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#1F2937",
        "line-width": [
          "interpolate", ["exponential", 1.4], ["zoom"],
          10, 0.6,
          14, 1.4,
          18, 3
        ]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#3A3A38",
        "line-opacity": 0.5,
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          4, 0.4,
          10, 1
        ],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#3A3A38",
        "line-opacity": 0.7,
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          2, 0.5,
          10, 1.6
        ],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "tunnel-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "tunnel"],
        ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"]]]
      ],
      "paint": {
        "line-color": "#2A2A2A",
        "line-opacity": 0.5,
        "line-dasharray": [2, 2],
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, 1,
          16, 4,
          18, 8
        ]
      }
    },
    {
      "id": "road-rail-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all", ["==", ["get", "class"], "rail"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3A3A38",
        "line-opacity": 0.4,
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          13, 1,
          18, 3,
          20, 5
        ]
      }
    },
    {
      "id": "road-service-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["all", ["==", ["get", "class"], "service"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#2D2D2D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          14, 0.6,
          16, 2,
          18, 5
        ]
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["all", ["==", ["get", "class"], "minor"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#2D2D2D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, 0.4,
          14, 1.6,
          16, 4.8,
          18, 11
        ]
      }
    },
    {
      "id": "road-tertiary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all", ["==", ["get", "class"], "tertiary"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#2D2D2D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          11, 0.6,
          14, 2.4,
          16, 6.5,
          18, 14
        ]
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["all", ["==", ["get", "class"], "secondary"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#2D2D2D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          10, 0.8,
          12, 1.6,
          14, 3.4,
          16, 8,
          18, 17
        ]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["all", ["==", ["get", "class"], "primary"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3A3A3A",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          9, 1,
          12, 2.2,
          14, 4.6,
          16, 10,
          18, 20
        ]
      }
    },
    {
      "id": "road-trunk-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["all", ["==", ["get", "class"], "trunk"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3A3A3A",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          8, 1,
          12, 2.4,
          14, 5,
          16, 11,
          18, 22
        ]
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["all", ["==", ["get", "class"], "motorway"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3A3A3A",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          7, 1.2,
          12, 3,
          14, 6,
          16, 13,
          18, 24
        ]
      }
    },
    {
      "id": "road-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all", ["==", ["get", "class"], "rail"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3A3A38",
        "line-dasharray": [3, 1.5],
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          13, 0.5,
          16, 1.4,
          20, 2.8
        ]
      }
    },
    {
      "id": "road-pedestrian",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "all",
        ["in", ["get", "class"], ["literal", ["pedestrian", "path", "track", "footway"]]],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": {
        "line-color": "#2D2D2A",
        "line-dasharray": [1.4, 1.4],
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          14, 0.6,
          16, 1.4,
          18, 2.5
        ]
      }
    },
    {
      "id": "road-service",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["all", ["==", ["get", "class"], "service"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3D3D3D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          14, 0.4,
          16, 1.4,
          18, 3.6
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["all", ["==", ["get", "class"], "minor"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3D3D3D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, 0.2,
          14, 1.2,
          16, 3.6,
          18, 9
        ]
      }
    },
    {
      "id": "road-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all", ["==", ["get", "class"], "tertiary"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3D3D3D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          11, 0.4,
          14, 1.8,
          16, 5,
          18, 11
        ]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["all", ["==", ["get", "class"], "secondary"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3D3D3D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          10, 0.5,
          12, 1.2,
          14, 2.8,
          16, 6.5,
          18, 14
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["all", ["==", ["get", "class"], "primary"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3D3D3D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          9, 0.6,
          12, 1.6,
          14, 3.6,
          16, 8.5,
          18, 17
        ]
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["all", ["==", ["get", "class"], "trunk"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#3D3D3D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          8, 0.6,
          12, 1.8,
          14, 4,
          16, 9.5,
          18, 19
        ]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["all", ["==", ["get", "class"], "motorway"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#454545",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          7, 0.8,
          12, 2.4,
          14, 4.8,
          16, 11,
          18, 21
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-color": "#252321",
        "fill-antialias": true,
        "fill-opacity": [
          "interpolate", ["linear"], ["zoom"],
          14.5, 0,
          15.5, 0.6,
          17, 0.9
        ]
      }
    },
    {
      "id": "building-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 16,
      "paint": {
        "line-color": "#33312E",
        "line-opacity": 0.5,
        "line-width": 0.5
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 6,
      "filter": ["==", ["geometry-type"], "Point"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic", "Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          6, 10,
          14, 13,
          18, 16
        ],
        "text-letter-spacing": 0.05,
        "text-max-width": 6,
        "symbol-placement": "point"
      },
      "paint": {
        "text-color": "#7B95A0",
        "text-halo-color": "rgba(26,22,20,0.9)",
        "text-halo-width": 1.2,
        "text-halo-blur": 1
      }
    },
    {
      "id": "road-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": [
        "in", ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "pedestrian"]]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          14, 10,
          18, 13
        ],
        "text-letter-spacing": 0.02,
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport",
        "text-max-angle": 35,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#9A9A9A",
        "text-halo-color": "rgba(26,22,20,0.9)",
        "text-halo-width": 1.2,
        "text-halo-blur": 1
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 13,
      "filter": ["in", ["get", "class"], ["literal", ["suburb", "neighbourhood", "quarter"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          12, 10,
          16, 13
        ],
        "text-letter-spacing": 0.04,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#9A938A",
        "text-halo-color": "rgba(26,22,20,0.9)",
        "text-halo-width": 1.2,
        "text-halo-blur": 1
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 10,
      "filter": ["in", ["get", "class"], ["literal", ["village", "hamlet"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          9, 10,
          14, 13
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#9A938A",
        "text-halo-color": "rgba(26,22,20,0.9)",
        "text-halo-width": 1.2,
        "text-halo-blur": 1
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 7,
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          7, 11,
          12, 14
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#9A938A",
        "text-halo-color": "rgba(26,22,20,0.9)",
        "text-halo-width": 1.2,
        "text-halo-blur": 1
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 4,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Medium", "Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          4, 11,
          8, 13,
          12, 16,
          15, 18
        ],
        "text-letter-spacing": 0.05,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#D4CCC2",
        "text-halo-color": "rgba(26,22,20,0.9)",
        "text-halo-width": 1.4,
        "text-halo-blur": 1.2
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 3,
      "maxzoom": 8,
      "filter": ["==", ["get", "class"], "state"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Medium", "Noto Sans Regular"],
        "text-transform": "uppercase",
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          3, 10,
          6, 12,
          8, 14
        ],
        "text-letter-spacing": 0.1,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#D4CCC2",
        "text-halo-color": "rgba(26,22,20,0.9)",
        "text-halo-width": 1.2,
        "text-halo-blur": 1
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 2,
      "maxzoom": 6,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Serif Regular", "Noto Sans Regular"],
        "text-transform": "uppercase",
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          2, 10,
          4, 12,
          6, 15
        ],
        "text-letter-spacing": 0.15,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#D4CCC2",
        "text-halo-color": "rgba(26,22,20,0.9)",
        "text-halo-width": 1.2,
        "text-halo-blur": 1.5
      }
    }
  ]
}
